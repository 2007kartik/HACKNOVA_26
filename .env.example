# Copy this file to backend/.env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
# DATABASE_URL=sqlite:///./meeting_agent.db
DATABASE_URL=postgresql://neondb_owner:npg_x8NUhkWDb1Aw@ep-late-snow-b5o6el8z-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Postgres example:
# DATABASE_URL=postgresql://user:password@localhost:5432/meeting_agent

# ── AI / Gemini ───────────────────────────────────────────────────────────────
# Set to false to use real Gemini API
USE_MOCK_AI=true
GEMINI_API_KEY_1=your_primary_gemini_api_key_here
GEMINI_API_KEY_2=your_fallback_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Trello ────────────────────────────────────────────────────────────────────
# Get from: https://trello.com/app-key
TRELLO_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token
TRELLO_BOARD_ID=your_trello_board_id

# ── Slack ─────────────────────────────────────────────────────────────────────
# Leave empty to disable Slack notifications
SLACK_WEBHOOK_URL=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token with repo scope
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token
# Format: owner/repo
GITHUB_REPO=2007kartik/HACKNOVA_26

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Scheduler ─────────────────────────────────────────────────────────────────
ENABLE_SCHEDULER=false
SYNC_INTERVAL_MINUTES=5
